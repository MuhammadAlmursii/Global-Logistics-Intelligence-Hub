# Environment Configuration
ENVIRONMENT=dev
DAGSTER_HOME=/opt/dagster/dagster_home

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_role

# Snowflake Connection (Alternative - using connection string)
SNOWFLAKE_CONNECTION_STRING=snowflake://user:password@account/database/schema?warehouse=warehouse&role=role

# dbt Configuration
DBT_PROFILES_DIR=/opt/dagster/dbt_profiles
DBT_PROJECT_DIR=/opt/dagster/dbt_projects

# Dagster Configuration
DAGSTER_TELEMETRY_ENABLED=false
DAGSTER_WEBSERVER_HOST=0.0.0.0
DAGSTER_WEBSERVER_PORT=3000

# Storage Configuration (for Dagster)
STORAGE_BACKEND=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dagster
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster_password

# Development Settings
DEBUG=true
LOG_LEVEL=INFO
