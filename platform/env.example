# Environment Configuration
ENVIRONMENT=dev
DAGSTER_HOME=/opt/dagster/dagster_home

# =============================================================================
# GCP BigQuery Configuration
# =============================================================================
GCP_PROJECT_ID=scenic-style-421412
GCP_BIGQUERY_DATASET=raw
GCP_BIGQUERY_LOCATION=US
GCP_BIGQUERY_METHOD=application-default
# Options for GCP_BIGQUERY_METHOD:
#   - application-default (uses Application Default Credentials)
#   - service-account (uses service account keyfile)
#   - service-account-json (uses service account JSON string)

# Service Account Authentication (if not using ADC)
# Use the service account JSON file in secrets directory
GCP_CREDENTIALS_PATH=secrets/gcp-sa.json
GCP_BIGQUERY_METHOD=service-account
# OR use Application Default Credentials (for local dev)
# GCP_BIGQUERY_METHOD=application-default
# OR provide JSON as string
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# BigQuery Job Configuration
GCP_BIGQUERY_JOB_TIMEOUT=300
GCP_BIGQUERY_PRIORITY=INTERACTIVE
# GCP_BIGQUERY_MAX_BYTES_BILLED=1000000000  # Optional: limit query costs

# =============================================================================
# GCP Cloud Storage (GCS) Configuration
# =============================================================================
GCP_GCS_BUCKET_NAME=your-bucket-name
GCP_GCS_RAW_DOCUMENTS_BUCKET=your-raw-documents-bucket
GCP_GCS_PROCESSED_DOCUMENTS_BUCKET=your-processed-documents-bucket
GCP_GCS_LOCATION=US

# =============================================================================
# Vertex AI Configuration
# =============================================================================
GCP_VERTEX_AI_LOCATION=us-central1
GCP_VERTEX_AI_EMBEDDING_MODEL=textembedding-gecko@003
GCP_VERTEX_AI_VISION_MODEL=imagetext@001
GCP_VECTOR_SEARCH_INDEX_ID=your-vector-index-id
GCP_VECTOR_SEARCH_INDEX_ENDPOINT=your-vector-index-endpoint
GCP_DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id
GCP_DOCUMENT_AI_LOCATION=us

# =============================================================================
# Pub/Sub Configuration (for IoT streams)
# =============================================================================
GCP_PUBSUB_IOT_TOPIC=iot-sensor-data
GCP_PUBSUB_IOT_SUBSCRIPTION=iot-sensor-data-sub
GCP_PUBSUB_MAX_MESSAGES=100
GCP_PUBSUB_MAX_WAIT_TIME=10

# =============================================================================
# GCP Security & Data Protection
# =============================================================================
GCP_DLP_LOCATION=global
GCP_DLP_INFO_TYPES=PHONE_NUMBER,EMAIL_ADDRESS,CREDIT_CARD_NUMBER,BANK_ACCOUNT
GCP_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCP_RBAC_ROLES=viewer,editor,admin

# =============================================================================
# Vector Database Configuration
# =============================================================================
VECTOR_DB_PROVIDER=vertex_ai
VECTOR_DB_INDEX_NAME=your-index-name
VECTOR_DB_DIMENSION=768
VECTOR_DB_ENABLE_HYBRID_SEARCH=true
VECTOR_DB_BM25_K1=1.2
VECTOR_DB_BM25_B=0.75

# =============================================================================
# RAG Configuration
# =============================================================================
RAG_CHUNKING_STRATEGY=semantic
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_ENABLE_PARENT_CHILD=true
RAG_PARENT_CHUNK_SIZE=5000
RAG_ENABLE_METADATA_ENRICHMENT=true
RAG_ENABLE_CACHING=true
RAG_CACHE_TTL_SECONDS=3600
RAG_USE_LATE_INTERACTION=false

# =============================================================================
# dbt Configuration
# =============================================================================
DBT_PROFILES_DIR=/opt/dagster/dbt_profiles
DBT_PROJECT_DIR=/opt/dagster/dbt_projects

# =============================================================================
# Dagster Configuration
# =============================================================================
DAGSTER_TELEMETRY_ENABLED=false
DAGSTER_WEBSERVER_HOST=0.0.0.0
DAGSTER_WEBSERVER_PORT=3000

# =============================================================================
# Storage Configuration (for Dagster metadata)
# =============================================================================
STORAGE_BACKEND=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dagster
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster_password

# =============================================================================
# Development Settings
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
DATA_WAREHOUSE=bigquery
